[Unit]
Description=AI Crypto Trading Bot — Altcoin Risky Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/botgrid
Environment=PATH=/opt/botgrid/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/botgrid/.env
ExecStart=/opt/botgrid/venv/bin/python -u altcoin_bot.py
ExecStartPost=/opt/botgrid/scripts/notify_restart.sh crypto-alt
Restart=always
RestartSec=15
StandardOutput=append:/opt/botgrid/alt_engine.log
StandardError=append:/opt/botgrid/alt_engine.log

[Install]
WantedBy=multi-user.target
