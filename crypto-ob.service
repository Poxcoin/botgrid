[Unit]
Description=AI Crypto Trading Bot — Order Block SMC (BTC/ETH/SOL)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/botgrid
Environment=PATH=/opt/botgrid/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/botgrid/.env
ExecStart=/opt/botgrid/venv/bin/python -u orderblock_bot.py
Restart=on-failure
RestartSec=15
StandardOutput=append:/opt/botgrid/orderblock.log
StandardError=append:/opt/botgrid/orderblock.log

[Install]
WantedBy=multi-user.target
