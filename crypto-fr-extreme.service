[Unit]
Description=AI Crypto Trading Bot — Funding Rate Extreme Reversal (10 coins)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/botgrid
Environment=PATH=/opt/botgrid/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/botgrid/.env
ExecStart=/opt/botgrid/venv/bin/python -u fr_extreme_bot.py
Restart=on-failure
RestartSec=15
StandardOutput=append:/opt/botgrid/fr_extreme.log
StandardError=append:/opt/botgrid/fr_extreme.log

[Install]
WantedBy=multi-user.target
