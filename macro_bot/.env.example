# OANDA — отримати на: https://developer.oanda.com
# Practice account: https://fxpractice.oanda.com
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_account_id_here   # формат: 001-001-XXXXXXX-001
OANDA_PRACTICE=true                     # true = demo, false = live

# BLS API (безкоштовно, реєстрація на bls.gov/developers)
# Без ключа: 25 запитів/день. З ключем: 500/день
BLS_API_KEY=

# FRED API (безкоштовно, реєстрація на fred.stlouisfed.org/docs/api)
FRED_API_KEY=

# Risk (налаштуй під свій депозит)
MACRO_RISK_PCT=0.015         # 1.5% від балансу на трейд
MACRO_MAX_TRADES=2           # max одночасних позицій
MACRO_SL_PIPS=15             # stop-loss в пунктах
MACRO_TP_PIPS=35             # take-profit в пунктах (2.3:1 R/R)
MACRO_EXIT_MINUTES=20        # примусове закриття через N хвилин

# Telegram (можна взяти з існуючого бота)
TG_BOT_TOKEN=
TG_CHAT_ID=
