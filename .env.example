# Bybit Demo Trading (get from: bybit.com → Demo Trading → API)
BYBIT_API_KEY=your_demo_api_key
BYBIT_SECRET=your_demo_secret
IS_DEMO_TRADING=True
USE_TESTNET=False

# AI (get from: console.anthropic.com)
CLAUDE_API_KEY=sk-ant-...

# Groq — free tier, 14400 req/day (get from: console.groq.com)
GROQ_API_KEY=gsk_...

# Alchemy — free tier (get from: alchemy.com)
ALCHEMY_API_KEY=your_alchemy_key

# Telegram userbot (get from: my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_hash
TELEGRAM_SESSION=botgrid

# Telegram admin bot (get from: @BotFather)
TG_BOT_TOKEN=123456:ABC...
TG_CHAT_ID=your_chat_id

# Telegram userbot (public bot for SaaS clients — @KADO_c_BOT)
USERBOT_TOKEN=123456:ABC...
USERBOT_USERNAME=KADO_c_BOT

# NewsAPI — free tier (get from: newsapi.org)
NEWSAPI_KEY=your_newsapi_key

# Web dashboard
DASHBOARD_PASSWORD=your_password

# Cascade Bot — управління торгівлею та акаунтом
# CASCADE_TRADING: вмикає реальне виконання угод (незалежно від SIGNAL_BOT_TRADING)
CASCADE_TRADING=False

# CASCADE_LIVE_MODE=True → cascade використовує окремі live ключі Bybit.
# Вмикати тільки після WR ≥ 29% на 30+ демо-угодах.
CASCADE_LIVE_MODE=False
CASCADE_LIVE_API_KEY=your_live_api_key
CASCADE_LIVE_SECRET=your_live_secret

# Опційно: окремий demo акаунт (якщо IS_DEMO_TRADING=False глобально)
CASCADE_IS_DEMO=False
CASCADE_DEMO_API_KEY=your_cascade_demo_api_key
CASCADE_DEMO_SECRET=your_cascade_demo_secret

# ── Orderflow Bot (BTC/ETH/SOL VWAP+OI+CVD) ────────────────────────────────
ORDERFLOW_TRADING=False
